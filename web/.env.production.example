APP_DOMAIN=schedule.example.com
APP_URL=https://schedule.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://schedule.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
V3_GRAPH_ENABLED=0
V3_ANALYSIS_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SCHEDULE_VISION_PROVIDER=qwen
SCHEDULE_VISION_MODEL=qwen3.8-flash
DASHSCOPE_API_KEY=replace-with-standard-api-key
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-hongkong.maas.aliyuncs.com/compatible-mode/v1
# compose.yaml 会根据以上变量在容器内部生成 DATABASE_URL 和 NEXT_PUBLIC_APP_URL。
# 任务附件：每成员200MiB、系统2GiB默认额度，正式发布前核定可用磁盘及备份容量。
TASK_USER_QUOTA_BYTES=209715200
TASK_TOTAL_QUOTA_BYTES=2147483648
