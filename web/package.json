{
  "name": "lab-schedule",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "test:integration": "node --experimental-test-module-mocks --import tsx --conditions react-server --test --test-concurrency=1 test/*.test.mts",
    "test:tasks-browser": "node --import tsx --conditions react-server test/tasks.browser.mts",
    "test:graph-browser": "node --import tsx --conditions react-server test/graph.browser.mts",
    "test:performance": "node --import tsx --conditions react-server scripts/performance-baseline.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-initial-data.mjs",
    "db:seed:li-yuhui": "node scripts/seed-member-li-yuhui.mjs",
    "db:seed:test-members": "node scripts/seed-test-members.mjs",
    "db:cleanup:test-members": "node scripts/cleanup-test-members.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "better-auth": "latest",
    "cheerio": "^1.2.0",
    "date-fns": "latest",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "latest",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "lucide-react": "latest",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "latest",
    "@types/cheerio": "^0.22.35",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.8",
    "server-only": "^0.0.1",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
